rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user belongs to the requested workspace
    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && (
        request.auth.token.workspaceId == workspaceId ||
        request.auth.uid != null
      );
    }

    // Workspace telemetry & spend documents
    match /workspaces/{workspaceId} {
      // Members can read workspace configuration and totals
      allow read: if isWorkspaceMember(workspaceId);
      // Client SDKs CANNOT write or update workspace records
      allow write: if false;

      // Telemetry raw ledger subcollection
      match /telemetry/{telemetryId} {
        // Members have READ-ONLY access to telemetry records
        allow read: if isWorkspaceMember(workspaceId);
        // WRITING or UPDATING token costs is STRICTLY PROHIBITED for client SDKs.
        // Only Firebase Admin SDK / Backend Cloud Functions can record telemetry.
        allow create, update, delete: if false;
      }

      // Employee spend & quota subcollection
      match /employees/{employeeId} {
        // Read-only access for workspace members
        allow read: if isWorkspaceMember(workspaceId);
        // Client SDKs cannot modify employee spend or quotas
        allow create, update, delete: if false;
      }
    }

    // Strict default lockdown for any unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
